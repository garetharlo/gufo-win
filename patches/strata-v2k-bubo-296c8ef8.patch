+// Fixed 2560/640, top-10, 512-expert decode chain. Q4_K gate/up and
+// Q5_1/Q8_0 down, N=2..8. Caller scratch persists across graph replay.
+size_t qfn_mmq_expert_v2k_scratch_bytes(int max_tokens);
+int qfn_mmq_expert_v2k(int gu_type, int down_type, const void* gate_w,
+                       const void* up_w, const void* down_w, const float* x,
+                       const int32_t* ids, float* gate, float* up, float* out,
+                       int n_tokens, void* scratch, size_t scratch_bytes,
+                       hipStream_t stream);
+// Stages used by the whole chain and the opt-in routed microbench.
+// GU outputs and hq are in compact entry order; down restores slot order.
+int qfn_mmq_expert_v2k_gu(const void* gate_w, const void* up_w, const float* x,
+                          const int32_t* ids, float* gate, float* up,
+                          int n_tokens, void* scratch, size_t scratch_bytes,
+                          hipStream_t stream);
+int qfn_mmq_expert_v2k_bridge(const float* gate, const float* up, void* hq,
+                              int entries, hipStream_t stream);
+int qfn_mmq_expert_v2k_down(int down_type, const void* weights, float* out,
+                            int n_tokens, void* scratch, size_t scratch_bytes,
+                            hipStream_t stream);
+
 size_t qfn_mmq_q8_1_bytes(int N, int K);
 
 int qfn_mmq_quantize_q8_1(const float* X_f32, void* X_q8, int N, int K,
diff --git a/src/models/qwen38_flash_next/kernels/rocm/mmq/s26_tsum.hpp b/src/models/qwen38_flash_next/kernels/rocm/mmq/s26_tsum.hpp
new file mode 100644
index 00000000..b97bbd29
--- /dev/null
+++ b/src/models/qwen38_flash_next/kernels/rocm/mmq/s26_tsum.hpp
@@ -0,0 +1,98 @@
+// SPDX-License-Identifier: MIT
+// Copyright (c) 2026 Niko1221 and the Strata contributors
+// Adapted from https://github.com/Niko1221/Strata
+// V2K/S26/S27: src/kernels/cuda/s26_tsum.cuh, measured base 82f46a8
+// (introduced by 04e1e11afb45c040960e90c834e0fe85a475a4ab).
+// Gufo adaptation: HIP includes and qfn_mmq namespace.
+// Full MIT permission and warranty notice: VENDOR.md in this directory.
+// S26: several warp sums at once (P per-lane values -> P sums), bitwise equal
+// to P separate xor-butterfly warp sums
+// (`for (o = 16; o > 0; o >>= 1) v += shfl_xor(v, o)`).  At offset 16 a lane
+// keeps half of its P values and adds the partner's copy of that half, at 8
+// half again, ... until one value is left, then plain xor steps for the
+// remaining offsets.  Every level adds the same pair of values as the butterfly
+// does (fp add commutes, so x + y == y + x bitwise), only each lane carries
+// fewer of them: P - 1 + (5 - log2 P) cross-lane moves instead of 5 P.  Value
+// j's sum ends in the lanes whose bits 4, 3, .. (MSB first) spell j:
+// tsum_lane<P>(j) is one of them.  On AMD the moves are DPP row_xmask /
+// permlanex16 instead of ds_bpermute.
+#pragma once
+
+#include <hip/hip_runtime.h>
+
+namespace qfn_mmq::s26ts {
+
+#if defined(__HIP_PLATFORM_AMD__)  // (permlanex16 / DPP row_xmask: gfx10+ only)
+__device__ __forceinline__ float xmov16(float v) {
+  return __int_as_float(
+      __builtin_amdgcn_permlanex16(__float_as_int(v), __float_as_int(v),
+                                   0x76543210u, 0xfedcba98u, false, false));
+}
+template<int O>
+__device__ __forceinline__ float xmov(float v) {
+  if constexpr (O == 16)
+    return xmov16(v);
+  else
+    return __int_as_float(__builtin_amdgcn_update_dpp(
+        0, __float_as_int(v), 0x160 + O, 0xf, 0xf, false));
+}
+#else
+template<int O>
+__device__ __forceinline__ float xmov(float v) {
+  return __shfl_xor(v, O, 32);
+}
+#endif
+
+__host__ __device__ constexpr int pow2_ceil(int t) {
+  return t <= 1 ? 1 : t <= 2 ? 2 : t <= 4 ? 4 : t <= 8 ? 8 : t <= 16 ? 16 : 32;
+}
+__host__ __device__ constexpr int log2c(int p) {
+  return p <= 1 ? 0 : p == 2 ? 1 : p == 4 ? 2 : p == 8 ? 3 : p == 16 ? 4 : 5;
+}
+
+template<int O>
+__device__ __forceinline__ float tplain(float x) {
+  if constexpr (O >= 1) {
+    x += xmov<O>(x);
+    return tplain<O / 2>(x);
+  } else
+    return x;
+}
+// v[0..CNT) (CNT a power of two <= 32): this lane's values; returns the sum of
+// value tsum_token<CNT>(lane)
+template<int CNT, int O = 16>
+__device__ __forceinline__ float tsum(float* v, int lane) {
+  if constexpr (CNT > 1) {
+    constexpr int H = CNT / 2;
+    const bool hi = (lane & O) != 0;
+#pragma unroll
+    for (int j = 0; j < H; ++j) {
+      const float send = hi ? v[j] : v[j + H];
+      const float keep = hi ? v[j + H] : v[j];
+      v[j] = keep + xmov<O>(send);
+    }
+    return tsum<H, O / 2>(v, lane);
+  } else {
+    return tplain<O>(v[0]);
+  }
+}
+template<int P>
+__device__ __forceinline__ int tsum_token(int lane) {
+  constexpr int L = log2c(P);
+  int k = 0;
+#pragma unroll
+  for (int b = 0; b < L; ++b)
+    k = (k << 1) | ((lane >> (4 - b)) & 1);
+  return k;
+}
+template<int P>
+__device__ __forceinline__ int tsum_lane(int k) {
+  constexpr int L = log2c(P);
+  int lane = 0;
+#pragma unroll
+  for (int b = 0; b < L; ++b)
+    lane |= ((k >> (L - 1 - b)) & 1) << (4 - b);
+  return lane;
+}
+
+}  // namespace qfn_mmq::s26ts
